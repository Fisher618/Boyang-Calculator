<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.boyang.calculator.controller.ScientificController"
      alignment="TOP_CENTER"
      spacing="18.0"
      styleClass="calculator-view">
    <VBox alignment="CENTER_RIGHT" minHeight="90.0" maxWidth="Infinity" styleClass="display-area">
        <padding>
            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
        </padding>
        <Label fx:id="expressionLabel" text="Scientific mode" maxWidth="Infinity" alignment="CENTER_RIGHT" styleClass="expression-label"/>
        <Label fx:id="displayLabel" text="0" maxWidth="Infinity" alignment="CENTER_RIGHT" styleClass="display-label"/>
    </VBox>
    <Region minHeight="0.0" VBox.vgrow="SOMETIMES"/>
    <GridPane hgap="8.0"
              vgap="8.0"
              maxWidth="Infinity"
              maxHeight="650.0"
              styleClass="calculator-grid,extended-grid"
              VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="25.0"/>
            <ColumnConstraints percentWidth="25.0"/>
            <ColumnConstraints percentWidth="25.0"/>
            <ColumnConstraints percentWidth="25.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="0.0" vgrow="ALWAYS"/>
            <RowConstraints minHeight="0.0" vgrow="ALWAYS"/>
            <RowConstraints minHeight="0.0" vgrow="ALWAYS"/>
            <RowConstraints minHeight="0.0" vgrow="ALWAYS"/>
            <RowConstraints minHeight="0.0" vgrow="ALWAYS"/>
            <RowConstraints minHeight="0.0" vgrow="ALWAYS"/>
            <RowConstraints minHeight="0.0" vgrow="ALWAYS"/>
            <RowConstraints minHeight="0.0" vgrow="ALWAYS"/>
        </rowConstraints>

        <Button text="(" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Button text=")" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button text="AC" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <Button text="DEL" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
        <Button text="sin" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Button text="cos" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Button text="tan" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <Button text="log" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
        <Button text="ln" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Button text="sqrt" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Button text="x²" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <Button text="xʸ" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
        <Button text="π" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Button text="e" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Button text="Deg/Rad" onAction="#handleScientificAction" styleClass="calc-button,function-button" GridPane.rowIndex="3" GridPane.columnIndex="2" GridPane.columnSpan="2"/>

        <Button text="7" onAction="#handleScientificAction" styleClass="calc-button,number-button" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Button text="8" onAction="#handleScientificAction" styleClass="calc-button,number-button" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Button text="9" onAction="#handleScientificAction" styleClass="calc-button,number-button" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
        <Button text="÷" onAction="#handleScientificAction" styleClass="calc-button,operator-button" GridPane.rowIndex="4" GridPane.columnIndex="3"/>
        <Button text="4" onAction="#handleScientificAction" styleClass="calc-button,number-button" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Button text="5" onAction="#handleScientificAction" styleClass="calc-button,number-button" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Button text="6" onAction="#handleScientificAction" styleClass="calc-button,number-button" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
        <Button text="×" onAction="#handleScientificAction" styleClass="calc-button,operator-button" GridPane.rowIndex="5" GridPane.columnIndex="3"/>
        <Button text="1" onAction="#handleScientificAction" styleClass="calc-button,number-button" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <Button text="2" onAction="#handleScientificAction" styleClass="calc-button,number-button" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        <Button text="3" onAction="#handleScientificAction" styleClass="calc-button,number-button" GridPane.rowIndex="6" GridPane.columnIndex="2"/>
        <Button text="-" onAction="#handleScientificAction" styleClass="calc-button,operator-button" GridPane.rowIndex="6" GridPane.columnIndex="3"/>
        <Button text="0" onAction="#handleScientificAction" styleClass="calc-button,number-button" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <Button text="." onAction="#handleScientificAction" styleClass="calc-button,number-button" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
        <Button text="=" onAction="#handleScientificAction" styleClass="calc-button,operator-button" GridPane.rowIndex="7" GridPane.columnIndex="2"/>
        <Button text="+" onAction="#handleScientificAction" styleClass="calc-button,operator-button" GridPane.rowIndex="7" GridPane.columnIndex="3"/>
    </GridPane>
</VBox>
